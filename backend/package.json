{
  "name": "whatsapp-crm-backend",
  "version": "1.0.0",
  "description": "WhatsApp Business Suite + Admissions CRM \u2014 backend API (Node, TypeScript, Express, MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts",
    "pm:setup": "ts-node-dev --transpile-only src/seed/pmSetup.ts",
    "pm:demo": "ts-node-dev --transpile-only src/seed/pmDemo.ts",
    "pm:test": "ts-node --transpile-only src/services/pm/dateEngine.test.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/jobs/worker.ts",
    "lint": "echo \"(add eslint as needed)\"",
    "campaigns:api-test": "node src/tests/campaigns.api.test.mjs",
    "website:test": "ts-node --transpile-only src/services/websiteData.test.ts",
    "website:api-test": "node src/tests/website.api.test.mjs",
    "crm:api-test": "node src/tests/crm.pro.api.test.mjs",
    "prereq:api-test": "node src/tests/prerequisites.api.test.mjs"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "express",
    "mongodb",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.36",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
